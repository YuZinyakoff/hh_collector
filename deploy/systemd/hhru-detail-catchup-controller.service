[Unit]
Description=HH.ru platform detail catch-up controller
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=hhru-ops-failure-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/hh_collector
EnvironmentFile=-/etc/hhru-platform/detail-catchup-controller.env
ExecStart=/opt/hh_collector/scripts/ops/run_detail_catchup_controller.sh
SuccessExitStatus=75
TimeoutStartSec=10m
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
